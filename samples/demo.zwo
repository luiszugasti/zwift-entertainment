<workout_file>
    <author>RideReel</author>
    <name>Demo pyramid</name>
    <description>Warm-up ramp through Z1-Z3, intervals, free ride and cool down.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="300" PowerLow="0.50" PowerHigh="0.85"/>
        <SteadyState Duration="240" Power="0.70"/>
        <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="1.10" OffPower="0.55"/>
        <SteadyState Duration="180" Power="0.95"/>
        <FreeRide Duration="120" FlatRoad="1"/>
        <SteadyState Duration="60" Power="1.25"/>
        <Cooldown Duration="240" PowerLow="0.75" PowerHigh="0.45"/>
    </workout>
</workout_file>
